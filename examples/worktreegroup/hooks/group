#!/bin/sh
# Example worktree group hook: one Serena MCP server per repo for Codex, in <group>/.codex/config.toml.
#   group changed <group> <sourceParent> <branch> <repo>...                  (cwd: the group)
# The block between the markers below is rewritten each time. The rest of the file (for example the parent's
# own .codex/config.toml, copied into the group) is kept, except any [mcp_servers.serena-<repo>] table for a
# repo of this group (and its sub-tables, like .env), which is replaced by the generated one.
set -eu
[ "$1" = changed ] || exit 0
group=$2
shift 4

begin="# >>> worktreegroup (generated by .worktreegroup/hooks/group)"
end="# <<< worktreegroup"
config="$group/.codex/config.toml"
# The mod copies real folders, but a group made by an older version may still have a .codex symlink into the
# parent: writing through it would change the parent's own config, so turn it into a real folder first.
if [ -L "$group/.codex" ]; then
  real=$(cd "$group/.codex" && pwd -P)
  rm "$group/.codex"
  mkdir "$group/.codex"
  [ -d "$real" ] && cp -Rp "$real/." "$group/.codex/"
fi
mkdir -p "$group/.codex"
[ -f "$config" ] || : > "$config"

toml() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
server() { printf 'serena-%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '-')"; }

names=""
for repo in "$@"; do names="$names $(server "$repo")"; done

# Drops our old block, and every table [mcp_servers.<one of names>] / [mcp_servers.<name>.*] up to the next table.
tmp="$config.tmp.$$"
awk -v b="$begin" -v e="$end" -v names="$names" '
  BEGIN { n = split(names, list, " "); for (i = 1; i <= n; i++) ours[list[i]] = 1 }
  $0 == b { block = 1; next }
  $0 == e { block = 0; drop = 0; next }
  block { next }
  /^[[:space:]]*\[/ {
    h = $0
    sub(/#.*/, "", h); gsub(/[[:space:]"]/, "", h)
    drop = 0
    if (h ~ /^\[mcp_servers\.[^]]*\]$/) {
      key = substr(h, 14, length(h) - 14); sub(/\..*/, "", key)
      if (key in ours) drop = 1
    }
  }
  !drop
' "$config" > "$tmp"
if [ "$#" -gt 0 ]; then
  {
    printf '%s\n' "$begin"
    for repo in "$@"; do
      printf '[mcp_servers.%s]\ncommand = "serena"\n' "$(server "$repo")"
      printf 'args = ["start-mcp-server", "--context", "codex", "--project", %s, "--open-web-dashboard", "false"]\n\n' "$(toml "$group/$repo")"
    done
    printf '%s\n' "$end"
  } >> "$tmp"
fi
mv "$tmp" "$config"
